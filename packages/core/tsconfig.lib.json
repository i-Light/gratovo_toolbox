{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The core has no I/O: no Node types and no DOM, so a stray fetch or fs call fails the typecheck.
    "lib": ["ES2025"],
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
