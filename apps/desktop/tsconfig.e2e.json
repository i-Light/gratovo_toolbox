{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Tests run in Node but pass callbacks to the page, so they see both worlds.
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  // env.d.ts types window.gratovo, which the tests call inside the page.
  "include": [
    "e2e/**/*.ts",
    "playwright.config.ts",
    "src/renderer/env.d.ts",
    "src/renderer/strings.ts"
  ],
  "references": [
    { "path": "./tsconfig.node.json" },
    { "path": "../../packages/ipc/tsconfig.lib.json" }
  ]
}
